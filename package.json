{
  "name": "humani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "lint": "next lint",
    "pm2:dev": "pm2 start ecosystem.config.js --only humani-dev",
    "pm2:prod": "pm2 start ecosystem.config.js --only humani-prod",
    "pm2:stop": "pm2 stop humani-dev humani-prod",
    "pm2:remove": "pm2 delete humani-dev humani-prod"
  },
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@next/third-parties": "latest",
    "@prisma/client": "^5.13.0",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "@types/react-slick": "^0.23.13",
    "argon2": "^0.45.1",
    "framer-motion": "^13.1.0",
    "install": "^0.13.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-intersection-observer": "^11.0.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-slick": "^0.31.0",
    "referral-codes": "^3.0.0",
    "slick-carousel": "^1.8.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10",
    "eslint-config-next": "latest",
    "postcss": "^8",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7"
  },
  "overrides": {
    "glob": "10.5.0",
    "react-slick": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "slick-carousel": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "framer-motion": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
